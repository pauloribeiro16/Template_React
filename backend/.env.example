# Copia este ficheiro para `.env` e ajusta os valores.
# O `.env` NUNCA é versionado — só o `.env.example` é.
#
# A DATABASE_URL leva a password real do Postgres: nunca a commites.

NODE_ENV=development
PORT=3000

# Postgres local. Ajusta user/password ao teu ambiente.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/react_template?schema=public"

# Origem permitida pelo CORS — o dev server do Vite
CORS_ORIGIN=http://localhost:5173
