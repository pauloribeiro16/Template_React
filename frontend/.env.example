# Copia este ficheiro para `.env` e ajusta os valores.
# O `.env` NUNCA é versionado — só o `.env.example` é.

# Caminho base da API. Em dev o Vite faz proxy de /api para o backend,
# por isso um caminho relativo basta e não há CORS no browser.
VITE_BASE_URL=/api

# Porta do backend usada pelo proxy de dev (opcional, default http://localhost:3000)
VITE_PROXY_TARGET=http://localhost:3000
